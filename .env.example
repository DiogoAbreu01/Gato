# Variaveis exclusivamente para a VM Oracle. NUNCA versionar .env verdadeiro.
# DATABASE_URL para consultas da app (pooled da Neon, SSL obrigatório)
DATABASE_URL="postgresql://neondb_owner:URL_ENCODED_PASSWORD@ep-EXEMPLO-pooler.c-2.sa-east-1.aws.neon.tech/neondb?sslmode=require"
# URL direta: backups e migrations, mesmo banco/branch, SEM -pooler.
DATABASE_URL_UNPOOLED="postgresql://neondb_owner:URL_ENCODED_PASSWORD@ep-EXEMPLO.c-2.sa-east-1.aws.neon.tech/neondb?sslmode=require"
APP_URL="https://gato.seudominio.org"
DOMAIN="gato.seudominio.org"
SESSION_COOKIE_NAME="gato_session"
ADMIN_EMAIL="admin@example.org"
ADMIN_PASSWORD="TROQUE_POR_UMA_SENHA_ALEATORIA_LONGA"
ADMIN_NAME="Administrador"
# rclone configurado apenas na VM. Ex.: oracle-storage:gato-backups
BACKUP_REMOTE=
