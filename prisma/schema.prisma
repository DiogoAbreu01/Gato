generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GlobalRole {
  ADMIN
  BOARD
  GENERAL
}

enum DepartmentRole {
  DIRECTOR
  EDITOR
  VIEWER
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  AWAY
  LEFT
}

enum EventStatus {
  PLANNING
  APPROVAL
  APPROVED
  PREPARING
  ACTIVE
  FINISHED
  CANCELLED
}

enum TaskStatus {
  TODO
  DOING
  REVIEW
  DONE
  CANCELLED
}

enum FinanceKind {
  INCOME
  EXPENSE
}

enum FinanceStatus {
  PENDING
  POSTED
  REVERSED
}

enum PublicationStatus {
  IDEA
  PRODUCTION
  REVIEW
  APPROVED
  SCHEDULED
  PUBLISHED
}

model User {
  id          String @id @default(uuid())
  name        String
  email       String @unique
  passwordHash String
  globalRole  GlobalRole @default(GENERAL)
  active      Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  sessions    Session[]
  departments UserDepartment[]
  member      Member?
  auditLogs   AuditLog[]
  notifications Notification[]
  assignments Task[] @relation("TaskOwner")
}

model Session {
  id        String @id @default(uuid())
  userId    String
  tokenHash String @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model LoginThrottle {
  key         String @id
  failures    Int @default(0)
  blockedUntil DateTime?
  updatedAt   DateTime @updatedAt
}

model Department {
  id        String @id @default(uuid())
  key       String @unique
  name      String
  active    Boolean @default(true)
  createdAt DateTime @default(now())
  users     UserDepartment[]
  members   MemberDepartment[]
  events    Event[]
  tasks     Task[]
  publications Publication[]
  transactions FinancialTransaction[]
  teams     EsportsTeam[]
  tournaments Tournament[]
  projects  Project[]
  documents Document[]
  occurrences DisciplinaryOccurrence[]
}

model UserDepartment {
  userId       String
  departmentId String
  role         DepartmentRole @default(VIEWER)
  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  @@id([userId, departmentId])
}

model Member {
  id           String @id @default(uuid())
  userId       String? @unique
  name         String
  preferredName String?
  nickname     String?
  enrollment   String? @unique
  course       String?
  position     String?
  contact      String?
  status       MemberStatus @default(ACTIVE)
  joinedAt     DateTime @default(now())
  archivedAt   DateTime?
  version      Int @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  departments  MemberDepartment[]
  statusHistory MemberStatusHistory[]
  occurrences DisciplinaryOccurrence[]
  @@index([name])
}

model MemberDepartment {
  memberId     String
  departmentId String
  member       Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  @@id([memberId, departmentId])
}

model MemberStatusHistory {
  id          String @id @default(uuid())
  memberId    String
  fromStatus  MemberStatus?
  toStatus    MemberStatus
  reason      String?
  changedById String
  createdAt   DateTime @default(now())
  member      Member @relation(fields: [memberId], references: [id], onDelete: Restrict)
  @@index([memberId, createdAt])
}

model DisciplinaryOccurrence {
  id           String @id @default(uuid())
  memberId     String
  departmentId String
  type         String
  points       Int
  justification String
  registeredById String
  adjustmentPoints Int @default(0)
  reviewedAt   DateTime?
  archivedAt   DateTime?
  version      Int @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  member       Member @relation(fields: [memberId], references: [id], onDelete: Restrict)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  adjustments  DisciplinaryAdjustment[]
  @@index([memberId, createdAt])
}

model DisciplinaryAdjustment {
  id           String @id @default(uuid())
  occurrenceId String
  deltaPoints  Int
  reason       String
  changedById  String
  createdAt    DateTime @default(now())
  occurrence   DisciplinaryOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Restrict)
}

model Event {
  id           String @id @default(uuid())
  name         String
  description  String?
  type         String?
  venue        String?
  startsAt     DateTime
  endsAt       DateTime?
  status       EventStatus @default(PLANNING)
  capacity     Int?
  budget       Decimal? @db.Decimal(14, 2)
  departmentId String
  archivedAt   DateTime?
  version      Int @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  tasks        Task[]
  transactions FinancialTransaction[]
  publications Publication[]
  @@index([startsAt])
  @@index([departmentId, status])
}

model Task {
  id           String @id @default(uuid())
  title        String
  description  String?
  departmentId String
  eventId      String?
  assigneeId   String?
  dueAt        DateTime?
  priority     Int @default(2)
  status       TaskStatus @default(TODO)
  archivedAt   DateTime?
  version      Int @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  event        Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  assignee     User? @relation("TaskOwner", fields: [assigneeId], references: [id], onDelete: SetNull)
  @@index([departmentId, status, dueAt])
  @@index([assigneeId])
}

model FinancialAccount {
  id           String @id @default(uuid())
  name         String
  active       Boolean @default(true)
  createdAt    DateTime @default(now())
  transactions FinancialTransaction[]
}

model FinancialCategory {
  id           String @id @default(uuid())
  name         String @unique
  transactions FinancialTransaction[]
}

model FinancialTransaction {
  id             String @id @default(uuid())
  description    String
  kind           FinanceKind
  status         FinanceStatus @default(POSTED)
  amount         Decimal @db.Decimal(14, 2)
  occurredAt     DateTime
  dueAt          DateTime?
  departmentId   String
  eventId        String?
  accountId      String
  categoryId     String?
  reversalOfId   String? @unique
  reversalOf     FinancialTransaction? @relation("FinancialReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy     FinancialTransaction? @relation("FinancialReversal")
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  department     Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  event          Event? @relation(fields: [eventId], references: [id], onDelete: Restrict)
  account        FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category       FinancialCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  @@index([departmentId, occurredAt])
  @@index([accountId, occurredAt])
}

model Publication {
  id           String @id @default(uuid())
  title        String
  channel      String
  caption      String?
  scheduledAt  DateTime?
  status       PublicationStatus @default(IDEA)
  departmentId String
  eventId      String?
  archivedAt   DateTime?
  version      Int @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  event        Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  @@index([scheduledAt])
}

model EsportsTeam {
  id           String @id @default(uuid())
  name         String
  game         String
  captain      String?
  roster       String?
  departmentId String
  archivedAt   DateTime?
  version      Int @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  @@index([departmentId])
}

model Tournament {
  id           String @id @default(uuid())
  name         String
  game         String
  organizer    String?
  startsAt     DateTime?
  endsAt       DateTime?
  result       String?
  departmentId String
  archivedAt   DateTime?
  version      Int @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
}

model Project {
  id           String @id @default(uuid())
  title        String
  description  String?
  status       String @default("PLANNING")
  dueAt        DateTime?
  departmentId String
  archivedAt   DateTime?
  version      Int @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
}

model Document {
  id           String @id @default(uuid())
  title        String
  description  String?
  externalUrl  String?
  storageKey   String? @unique
  fileName     String?
  contentType  String?
  sizeBytes    Int?
  private      Boolean @default(true)
  departmentId String
  archivedAt   DateTime?
  version      Int @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
}

model Notification {
  id        String @id @default(uuid())
  userId    String
  title     String
  body      String?
  href      String?
  readAt    DateTime?
  createdAt DateTime @default(now())
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, readAt, createdAt])
}

model AuditLog {
  id         String @id @default(uuid())
  userId     String
  action     String
  resource   String
  recordId   String
  details    Json?
  createdAt  DateTime @default(now())
  user       User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([resource, recordId, createdAt])
  @@index([userId, createdAt])
}

model OrganizationSetting {
  key       String @id
  value     Json
  updatedAt DateTime @updatedAt
}
